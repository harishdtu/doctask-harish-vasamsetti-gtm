# growth_machine works with ZERO environment variables set.
# Everything below is optional configuration for future integrations.
# Never put a real value in this file -- it is committed to git.

# Optional: path to a curated public_targets.json for public-company mode.
# GROWTH_MACHINE_PUBLIC_INPUT=data/public_targets.json

# Optional: only relevant if you wire in integrations/superdocs.py.
# SUPERDOCS_API_KEY=

# Safety posture is hard-coded in growth_machine/cli.py and is NOT
# configurable via environment variables on purpose:
#   DRY_RUN=true
#   SEND_MESSAGES=false
